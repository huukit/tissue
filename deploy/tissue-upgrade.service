[Unit]
Description=tissue upgrade: poll latest GitHub Release and swap the binary
Documentation=https://github.com/huukit/tissue
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as the dedicated unprivileged `tissue` user (#132), which owns the
# binary dir (/opt/tissue/bin) and may control tissue.service via a polkit
# rule or sudoers entry — see deploy/README.md fresh-box setup.
User=tissue
Group=tissue
Environment=TISSUE_REPO_SLUG=huukit/tissue
Environment=TISSUE_BIN_DIR=/opt/tissue/bin
ExecStart=/usr/local/lib/tissue/tissue-upgrade.sh

[Install]
WantedBy=multi-user.target
